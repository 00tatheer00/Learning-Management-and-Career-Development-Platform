# Database (MongoDB)
DATABASE_URL="mongodb+srv://user:pass@cluster.mongodb.net/eest?retryWrites=true&w=majority"
# Optional: direct connection for migrations in dev
# DATABASE_URL_DIRECT=

# Auth (required in production)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-long-random-string"
# Separate secret for encrypting stored portal passwords (recommended in production)
PORTAL_PASSWORD_SECRET="generate-another-long-random-string"

# Seed passwords (required when running db:seed in production)
SEED_ADMIN_PASSWORD=
SEED_KOMAL_PASSWORD=
SEED_TRAINER_TATHEER_PASSWORD=
SEED_TRAINER_TALHA_PASSWORD=
SEED_TRAINER_FAIZA_PASSWORD=
SEED_STUDENT_PASSWORD=

# Cloudinary (payment screenshots)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Resend) — optional
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
CONTACT_INBOX_EMAIL=
# Route student class/assignment emails to demo inbox only (set true to test on demo email)
STUDENT_EMAIL_DEMO_ONLY=false

# WhatsApp Cloud API (Meta) — approve/reject + admin inbox
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_APPROVED=
WHATSAPP_TEMPLATE_REJECTED=
ADMIN_ALERT_WHATSAPP=

# Bunny Stream (secure lecture videos)
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_TOKEN_KEY=
# Optional pull zone hostname (docs / CDN)
# BUNNY_STREAM_PULL_ZONE=

# Rate limiting (Upstash Redis) — optional; in-memory fallback used if unset
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cron automation endpoint (triggered by GitHub Actions — see .github/workflows/cron-automation.yml)
CRON_SECRET=

# Public
NEXT_PUBLIC_STUDENT_WHATSAPP_GROUP_URL=
NEXT_PUBLIC_SITE_URL=https://school.emergingedge.tech

# Video (Jitsi fallback domain)
JITSI_DOMAIN=meet.jit.si
