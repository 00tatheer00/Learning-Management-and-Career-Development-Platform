generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  student
  trainer
  admin
  admin_readonly
}

enum EnrollmentStatus {
  pending
  approved
  rejected
}

enum MaterialType {
  video
  link
  document
}

enum SubmissionStatus {
  submitted
  approved
  needs_revision
}

model PasswordResetToken {
  id        String   @id @map("_id")
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model User {
  id              String   @id @map("_id")
  email           String   @unique
  passwordHash    String
  role            UserRole
  name            String
  phone           String?
  programSlug     String?
  level           String?
  batch           String?  @default("Batch 1")
  trainerId       String?
  avatarInitials  String?
  avatarUrl       String?
  designation     String?
  bio             String?
  experience      String?
  expertise       String[] @default([])
  imagePosition   String?
  isActive        Boolean  @default(true)
  activeSessionId String?
  firstLoginAt    DateTime?
  lastLoginAt     DateTime?
  lastActiveAt    DateTime?
  createdAt       DateTime @default(now())

  submissions AssignmentSubmission[] @relation("StudentSubmissions")
  attendance  ClassAttendance[]        @relation("StudentAttendance")
  moduleEnrollments ModuleEnrollment[] @relation("UserModuleEnrollments")
  certificates Certificate[]           @relation("StudentCertificates")
  topicAssignments StudentTopicAssignment[] @relation("UserTopicAssignments")
  notifications Notification[]         @relation("UserNotifications")

  @@index([role])
  @@index([programSlug])
  @@index([role, programSlug])
}

model Enrollment {
  id                        String           @id @map("_id")
  fullName                  String
  fatherName                String
  institution               String
  classSemester             String
  cnic                      String
  email                     String
  whatsapp                  String
  fieldOfStudy              String
  program                   String
  level                     String
  batch                     String           @default("Batch 1")
  learningMode              String
  hasLaptop                 String
  internetAvailable         String
  confirmInfoCorrect        Boolean
  agreeToPolicies           Boolean
  paymentScreenshot         String?
  paymentScreenshotPublicId String?
  profilePhotoUrl           String?
  profilePhotoPublicId      String?
  /// Encrypted portal password for admin reveal — login uses User.passwordHash
  portalPasswordEnc         String?
  status                    EnrollmentStatus @default(pending)
  reviewedAt                DateTime?
  reviewedBy                String?
  adminNotes                String?
  approvalEmailSent         Boolean?
  approvalEmailError        String?
  portalWelcomeShownAt      DateTime?
  createdAt                 DateTime         @default(now())

  moduleEnrollments ModuleEnrollment[] @relation("EnrollmentModuleEnrollments")

  @@index([status])
  @@index([email])
  @@index([program])
  @@index([program, status, level])
  @@index([email, status])
}

model CourseMaterial {
  id          String       @id @map("_id")
  programSlug String
  level       String?
  title       String
  description String
  type        MaterialType
  url         String
  order       Int
}

model Assignment {
  id          String   @id @map("_id")
  programSlug String
  level       String?
  title       String
  description String
  dueDate     String
  trainerId   String
  createdAt   DateTime @default(now())

  submissions AssignmentSubmission[]
}

model AssignmentSubmission {
  id             String           @id @map("_id")
  assignmentId   String
  studentId      String
  studentName    String
  content        String
  liveWebsiteUrl String?
  githubUrl      String?
  portfolioUrl   String?
  assignedTopic  String?
  notes          String?
  status         SubmissionStatus @default(submitted)
  submittedAt    DateTime         @default(now())
  feedback       String?
  reviewedAt     DateTime?

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation("StudentSubmissions", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([assignmentId, status])
  @@index([studentId, assignmentId])
}

model LiveSession {
  id           String    @id @map("_id")
  programSlug  String
  level        String?
  title        String
  startsAt     DateTime?
  timezone     String    @default("Asia/Karachi")
  date         String
  time         String
  meetLink     String    @default("")
  roomType     String    @default("meet")
  roomName     String?
  roomPassword String?
  trainerId    String
  trainerName  String
  notes        String?

  attendances ClassAttendance[]
}

model AutomationSendLog {
  id     String   @id @map("_id")
  key    String   @unique
  type   String
  sentAt DateTime @default(now())
}

model ClassAttendance {
  id          String   @id @map("_id")
  sessionId   String
  studentId   String
  studentName String
  programSlug String
  sessionDate String
  sessionTime String
  joinedAt    DateTime @default(now())
  status      String
  /// portal_join | manual
  markSource  String?
  markedBy    String?
  adminNote   String?

  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student User        @relation("StudentAttendance", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([programSlug, sessionDate])
}

model ClassRecording {
  id          String   @id @map("_id")
  programSlug String
  level       String?
  classNumber Int
  title       String
  driveUrl    String
  trainerId   String
  trainerName String
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([programSlug, classNumber])
  @@index([programSlug, level])
}

model Lecture {
  id           String   @id @map("_id")
  programSlug  String
  level        String?
  title        String
  description  String   @default("")
  order        Int
  bunnyVideoId String?
  duration     Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  watchProgress WatchProgress[]

  @@index([programSlug, order])
}

model WatchProgress {
  id             String   @id @map("_id")
  userId         String
  lectureId      String
  watchedSeconds Float    @default(0)
  completed      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lecture Lecture @relation(fields: [lectureId], references: [id], onDelete: Cascade)

  @@unique([userId, lectureId])
  @@index([userId])
}

model ModuleEnrollment {
  id           String    @id @map("_id")
  studentId    String?
  enrollmentId String?
  email        String
  programSlug  String
  moduleName   String
  status       String    @default("active")
  enrolledAt   DateTime  @default(now())
  completedAt  DateTime?
  unlockedAt   DateTime  @default(now())

  user       User?       @relation("UserModuleEnrollments", fields: [studentId], references: [id], onDelete: Cascade)
  enrollment Enrollment? @relation("EnrollmentModuleEnrollments", fields: [enrollmentId], references: [id], onDelete: SetNull)

  @@unique([email, programSlug, moduleName])
  @@index([email])
  @@index([studentId])
  @@index([programSlug])
}

model Certificate {
  id                  String   @id @map("_id")
  studentId           String
  studentNameSnapshot String
  programSlug         String
  courseNameSnapshot  String
  moduleName          String
  moduleNameSnapshot  String
  verificationCode    String   @unique
  certificateNumber   String
  completionDate      DateTime
  issuedAt            DateTime @default(now())
  status              String   @default("issued")
  pdfUrl              String?

  student User @relation("StudentCertificates", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, programSlug, moduleName])
  @@index([studentId])
  @@index([programSlug])
}

model StudentTopicAssignment {
  id            String   @id @map("_id")
  studentId     String
  studentName   String?
  email         String
  programSlug   String   @default("web-development")
  moduleName    String   @default("HTML & CSS")
  topic         String
  topicCategory String?
  assignedAt    DateTime @default(now())

  user User @relation("UserTopicAssignments", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, programSlug, moduleName])
  @@index([email])
  @@index([programSlug, moduleName])
}

model Notification {
  id        String   @id @map("_id")
  userId    String
  title     String
  message   String
  type      String   @default("info")
  isRead    Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())

  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

